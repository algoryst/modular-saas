[importlinter]
root_package = apps
include_external_packages = False

# Feature apps never import each other; cross-app effects go through core.events.
# Add every new feature app here.
[importlinter:contract:feature-independence]
name = Feature apps are independent
type = independence
modules =
    apps.accounts
    apps.marketing

# core is the shared kernel: every app may import it, it imports no feature app.
# Add every new feature app here.
[importlinter:contract:core-is-kernel]
name = Core imports no feature app
type = forbidden
source_modules =
    apps.core
forbidden_modules =
    apps.accounts
    apps.countrypacks
    apps.marketing

# Country packs never import each other; shared types live in countrypacks.base.
# Add every new pack here.
[importlinter:contract:country-packs-independent]
name = Country packs are independent
type = independence
modules =
    apps.countrypacks.fr
    apps.countrypacks.generic

# view -> form -> service -> repository -> model, inside each app.
# Parentheses mark layers an app may not have yet. Add every new app to containers.
[importlinter:contract:layers]
name = Layered architecture inside each app
type = layers
layers =
    (views)
    (forms)
    (services)
    (repositories)
    (models)
containers =
    apps.accounts
    apps.marketing
