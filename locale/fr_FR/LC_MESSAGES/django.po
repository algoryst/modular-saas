msgstr "Devis signés en ligne par signature électronique simple"

#: apps/marketing/templates/marketing/landing.html:17
msgid "Planned: invoicing for the 2027 e-invoicing reform"
msgstr "Prévu : la facturation pour la réforme de la facture électronique 2027"

#: apps/marketing/templates/marketing/landing.html:21
msgid "For Django developers"
msgstr "Pour les développeurs Django"

#: apps/marketing/templates/marketing/landing.html:23
msgid "A multi-tenant Django boilerplate with billing, auth and 2FA"
msgstr ""
"Un boilerplate Django multi-tenant avec facturation, authentification et 2FA"

#: apps/marketing/templates/marketing/landing.html:24
msgid "Strict layers, events between apps, tests from day one"
msgstr ""
"Couches strictes, événements entre applications, tests dès le premier jour"

