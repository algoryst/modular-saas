msgstr "Pilotez votre petite entreprise depuis un seul espace simple"

#: apps/marketing/templates/marketing/landing.html:8
msgid ""
"Contacts, deals and quotes with simple electronic signature. Built for "
"French SMEs, launching soon."
msgstr ""
"Contacts, affaires et devis avec signature électronique simple. Conçu pour "
"les PME françaises, bientôt disponible."

#: apps/marketing/templates/marketing/landing.html:13
