#: apps/marketing/templates/marketing/privacy.html:3
#: apps/marketing/templates/marketing/privacy.html:7
#: apps/templates/base.html:56
msgid "Privacy notice"
msgstr "Politique de confidentialité"

#: apps/marketing/templates/marketing/privacy.html:9
msgid "Controller"
msgstr "Responsable du traitement"

#: apps/marketing/templates/marketing/privacy.html:10
msgid "[Full name], [address], [contact email]"
msgstr "[Nom complet], [adresse], [e-mail de contact]"

#: apps/marketing/templates/marketing/privacy.html:13
msgid "Waitlist"
msgstr "Liste d'attente"

#: apps/marketing/templates/marketing/privacy.html:15
msgid ""
"We collect your email address and the product you are interested in, only to "
"tell you about the launch. Legal basis: your consent. You confirm it by "
"clicking the link in our confirmation email, and you can withdraw it at any "
"time with the unsubscribe link."
msgstr ""
"Nous collectons votre adresse e-mail et le produit qui vous intéresse, "
"uniquement pour vous informer du lancement. Base légale : votre "
"consentement. Vous le confirmez en cliquant sur le lien de notre e-mail de "
"confirmation, et vous pouvez le retirer à tout moment via le lien de "
"désinscription."

#: apps/marketing/templates/marketing/privacy.html:17
msgid "Retention: [retention period]"
msgstr "Durée de conservation : [durée]"

#: apps/marketing/templates/marketing/privacy.html:20
msgid "Sub-processors"
msgstr "Sous-traitants"

#: apps/marketing/templates/marketing/privacy.html:21
msgid "[List: Brevo (email), hosting provider, ...]"
msgstr "[Liste : Brevo (e-mail), hébergeur, ...]"

#: apps/marketing/templates/marketing/privacy.html:24
msgid "Cookies"
msgstr "Cookies"

#: apps/marketing/templates/marketing/privacy.html:26
msgid ""
"We only set cookies that are strictly necessary: your session, protection "
"against forged requests, and, if you choose a language, a cookie that "
"remembers that choice."
msgstr ""
"Nous ne déposons que des cookies strictement nécessaires : votre session, la "
"protection contre les requêtes falsifiées et, si vous choisissez une langue, "
"un cookie qui mémorise ce choix."

#: apps/marketing/templates/marketing/privacy.html:30
msgid "Audience measurement"
msgstr "Mesure d'audience"

#: apps/marketing/templates/marketing/privacy.html:31
msgid "[Analytics tool and its CNIL-exempt configuration]"
msgstr "[Outil de mesure d'audience et sa configuration exemptée CNIL]"

#: apps/marketing/templates/marketing/privacy.html:34
msgid "Your rights"
msgstr "Vos droits"

#: apps/marketing/templates/marketing/privacy.html:36
msgid ""
"You can access, correct or delete your data by writing to [contact email]. "
"You can also lodge a complaint with the CNIL."
msgstr ""
"Vous pouvez accéder à vos données, les rectifier ou les supprimer en "
"écrivant à [e-mail de contact]. Vous pouvez aussi introduire une réclamation "
"auprès de la CNIL."

