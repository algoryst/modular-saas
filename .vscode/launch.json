{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Django (Docker)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "/app" }],
      "django": true,
      "justMyCode": true,
      "subProcess": true
    },
    {
      "name": "Debug a test (Docker)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5679 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "/app" }],
      "django": true,
      "justMyCode": false
    }
  ]
}
